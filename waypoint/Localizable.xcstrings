{
  "sourceLanguage": "es",
  "strings": {
    "applock.reason": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Unlock Waypoint"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Desbloquear Waypoint"
          }
        }
      }
    },
    "applock.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Waypoint is locked"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Waypoint está bloqueada"
          }
        }
      }
    },
    "applock.unlock": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Unlock"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Desbloquear"
          }
        }
      }
    },
    "notification.monthly.body %@": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Anything from %@ left to write down?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Te dejas algo de %@ sin apuntar?"
          }
        }
      }
    },
    "notification.monthly.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The month sets sail"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El mes zarpa ya"
          }
        }
      }
    },
    "notification.weekly.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "What happened this week?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Qué ha pasado esta semana?"
          }
        }
      }
    },
    "notification.weekly.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your week in Waypoint"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu semana en Waypoint"
          }
        }
      }
    },
    "onboarding.notifications.accept": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enable reminders"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Activar recordatorios"
          }
        }
      }
    },
    "onboarding.notifications.decline": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Not now"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ahora no"
          }
        }
      }
    },
    "onboarding.notifications.message": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A gentle nudge every Sunday evening and at the end of each month, so no wave of your story slips away."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un pequeño recordatorio cada domingo por la tarde y al final de cada mes, para que ninguna ola de tu historia se escape."
          }
        }
      }
    },
    "onboarding.notifications.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Don't lose the thread"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No pierdas el hilo"
          }
        }
      }
    },
